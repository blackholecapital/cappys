{
  "name": "cappys-electrical",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run types:worker && npm run check:worker",
    "build:web": "vite build --config web/vite.config.ts",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.toml",
    "check": "npm run types:worker && tsc -p web/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "check:worker": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir .wrangler/dry-run",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cappys-db --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply cappys-db --remote --config worker/wrangler.toml",
    "deploy:web": "wrangler pages deploy web/dist --project-name cappys-electrical",
    "deploy:api": "node ../cloudflare-platform/scripts/deploy-with-secrets-store.mjs --config worker/wrangler.toml --store default_secrets_store --bind DEEPGRAM_API_KEY=XYZ_DEMO_DEEPGRAM_API_KEY --bind RESEND_API_KEY=XYZ_DEMO_RESEND_API_KEY --bind TWILIO_ACCOUNT_SID=XYZ_DEMO_TWILIO_ACCOUNT_SID --bind TWILIO_AUTH_TOKEN=XYZ_DEMO_TWILIO_AUTH_TOKEN --bind EILA_RUNTIME_TOKEN=XYZ_DEMO_EILA_RUNTIME_TOKEN --bind LIVEKIT_API_KEY=XYZ_DEMO_LIVEKIT_API_KEY --bind LIVEKIT_API_SECRET=XYZ_DEMO_LIVEKIT_API_SECRET"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.34.0"
  }
}
